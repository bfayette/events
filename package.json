{
  "name": "headless-ticketing-platform",
  "version": "2.0.0",
  "description": "Headless non-custodial e-ticketing & loyalty platform with Turnkey, Apple PassKit, Google Wallet JWT, and ERC-4337",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:e2e": "node scripts/e2e-test.js"
  },
  "keywords": [
    "turnkey",
    "passkit",
    "google-wallet",
    "erc4337",
    "account-abstraction",
    "totp",
    "passkey"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
