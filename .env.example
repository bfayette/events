# System Environment Variables Configuration

# Server Port & Environment
# HTTP server listening port (default: 3000)
PORT=3000

# Environment mode: development, test, or production (default: development)
NODE_ENV=development

# Signing Keys & Secrets
# Active operator key ID for JWS receipt signing (default: op-key-1)
OPERATOR_KEY_ID=op-key-1

# Active operator secret for JWS receipt signing (required in production, min 32 chars)
# generate with: openssl rand -base64 48
OPERATOR_SECRET=

# Optional JSON map of previous key IDs to secrets for key rotation verification
# Example: OPERATOR_PREVIOUS_KEYS={"op-key-0":"..."}
OPERATOR_PREVIOUS_KEYS=

# Secret for Google Wallet JWT link generation (required in production, min 32 chars)
# generate with: openssl rand -base64 48
GOOGLE_WALLET_SECRET=

# Demo Data Seeding
# Populate in-memory stores with demo events, tickets, and loyalty accounts (default: true in dev/test, false in production; true forbidden in production)
SEED_DEMO_DATA=true

# Pass Credentials & Service Accounts (not used yet)
# Apple PassKit Credentials (.pkpass generation)
APPLE_PASS_TYPE_ID=pass.com.platform.event
APPLE_TEAM_ID=TEAM12345
APPLE_PASS_CERTIFICATE_PEM=
APPLE_PASS_PRIVATE_KEY_PEM=

# Google Wallet REST API & Service Account Configuration
GOOGLE_ISSUER_ID=33880000000221100
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@platform.iam.gserviceaccount.com
