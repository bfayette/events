# System Environment Variables Configuration

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Turnkey Configuration (Non-custodial sub-organization provisioning)
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORGANIZATION_ID=your-parent-organization-id
TURNKEY_API_PUBLIC_KEY=your-turnkey-api-public-key
TURNKEY_API_PRIVATE_KEY=your-turnkey-api-private-key

# Apple PassKit Credentials (.pkpass generation)
APPLE_PASS_TYPE_ID=pass.com.platform.event
APPLE_TEAM_ID=TEAM12345
APPLE_PASS_CERTIFICATE_PEM=
APPLE_PASS_PRIVATE_KEY_PEM=

# Google Wallet REST API & JWT Configuration
GOOGLE_ISSUER_ID=33880000000221100
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@platform.iam.gserviceaccount.com
GOOGLE_WALLET_SECRET=dev_secret_key_for_testing_123456

# ERC-4337 Account Abstraction (Gasless UserOperations)
ERC4337_ENTRYPOINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
ERC4337_PAYMASTER_URL=https://paymaster.platform.com/v1/sponsor
ERC4337_BUNDLER_URL=https://bundler.platform.com/v1/rpc
